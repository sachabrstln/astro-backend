# ════════════════════════════════════════════════════════════════
#  ASTRO BACKEND — Variables d'environnement (référence COMPLÈTE)
#  Toutes les vars lues par le code (src/*.js). À reporter sur Render.
#  Légende : [CRITIQUE] = sans ça une connexion/feature casse.
#            [OPTIONNEL] = a un défaut ou non bloquant.
# ════════════════════════════════════════════════════════════════

# ─── Server ──────────────────────────────────────────────────────
PORT=8787
NODE_ENV=production                       # [CRITIQUE] doit valoir "production" en prod
FRONTEND_URL=https://astro-pro.app        # [CRITIQUE] redirections Stripe + liens email
CHROME_EXTENSION_IDS=agioiggjedkaglpcnfdgicdlgmhjfgjj   # [CRITIQUE] CORS extension (séparés par virgule)

# ─── Database (Supabase Postgres) ────────────────────────────────
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECTREF.supabase.co:5432/postgres  # [CRITIQUE]
DATABASE_SSL_STRICT=0                      # [OPTIONNEL] 1 = vérifie le CA (prod durcie)
# DATABASE_CA=-----BEGIN CERTIFICATE-----...   # [OPTIONNEL] requis si DATABASE_SSL_STRICT=1

# ─── Auth ────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-64-char-random-string        # [CRITIQUE] ≥ 32 chars (openssl rand -hex 32)
EXTENSION_SHARED_SECRET=astro_ext_xxxxxxxxxxxxxxxxxxxx  # [CRITIQUE] HMAC extension↔backend
# LEGACY_JWT_CUTOFF=2026-05-15             # [OPTIONNEL] date de rejet des vieux JWT sans jti

# ─── Anthropic (RepAuto IA + Assistant SEO) ──────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxx  # [CRITIQUE] sinon AI_REPLY + SEO HS

# ─── Stripe — clés ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx          # [CRITIQUE] sk_test_ en test, sk_live_ en prod
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx        # [CRITIQUE] sinon webhooks rejetés (signature)

# ─── Stripe — abonnements (6 price IDs : mensuel + annuel) ────────
# ⚠️ Le code lit CES noms exacts (plans.js priceEnvMonthly/Annual).
# Les anciens noms STRIPE_PRICE_STARTER/PRO/ULTRA (sans _MONTHLY) ne sont PLUS lus.
STRIPE_PRICE_STARTER_MONTHLY=price_xxxxxxxxxxxxx        # [CRITIQUE] 17€/mois
STRIPE_PRICE_STARTER_ANNUAL=price_xxxxxxxxxxxxx         # [CRITIQUE] 15,30€/mois (183,60€/an)
STRIPE_PRICE_PRO_MONTHLY=price_xxxxxxxxxxxxx            # [CRITIQUE] 35€/mois
STRIPE_PRICE_PRO_ANNUAL=price_xxxxxxxxxxxxx             # [CRITIQUE] 31,50€/mois (378€/an)
STRIPE_PRICE_ULTRA_MONTHLY=price_xxxxxxxxxxxxx          # [CRITIQUE] 69€/mois — utilisé aussi pour le trial 7j
STRIPE_PRICE_ULTRA_ANNUAL=price_xxxxxxxxxxxxx           # [CRITIQUE] 62,10€/mois (745,20€/an)
# STRIPE_PRICE_MAX=price_xxxxxxxxxxxxx                  # [OPTIONNEL] plan "max" déprécié (anciens comptes)

# ─── Stripe — packs Multipost IA (achat one-time) ────────────────
STRIPE_PACK_PRICE_10=price_xxxxxxxxxxxxx                # [CRITIQUE pour packs] 10 crédits
STRIPE_PACK_PRICE_25=price_xxxxxxxxxxxxx                # [CRITIQUE pour packs] 25 crédits
STRIPE_PACK_PRICE_75=price_xxxxxxxxxxxxx                # [CRITIQUE pour packs] 75 crédits
STRIPE_PACK_PRICE_100=price_xxxxxxxxxxxxx               # [CRITIQUE pour packs] 100 crédits

# ─── Replicate (détourage bg-swap + relight IC-Light Studio) ─────
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxx             # [CRITIQUE] sinon Multipost détourage/Studio HS
# REPLICATE_BG_MODEL=cjwbw/rembg                        # [OPTIONNEL] override modèle détourage
# REPLICATE_RELIGHT_MODEL=zsxkib/ic-light-background    # [OPTIONNEL] override modèle relight
# REPLICATE_BG_COST_USD=0.0015                          # [OPTIONNEL] tracking coût
# REPLICATE_RELIGHT_COST_USD=0.033                      # [OPTIONNEL] tracking coût

# ─── Email transactionnel (Resend) ───────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx                  # [CRITIQUE] sinon vérif email signup impossible
EMAIL_FROM=Astro <noreply@astro-pro.app>               # [CRITIQUE] expéditeur (domaine vérifié Resend)

# ─── Captcha (Cloudflare Turnstile) ──────────────────────────────
CF_TURNSTILE_SECRET=0x4xxxxxxxxxxxxxxxxxxxx             # [CRITIQUE] sinon signup/login bloqués (sauf bypass HMAC ext)

# ─── Monitoring (Sentry) ─────────────────────────────────────────
# SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx    # [OPTIONNEL] reporting erreurs 5xx
# SENTRY_TRACES_SAMPLE_RATE=0.1                         # [OPTIONNEL]

# ─── Dev only ────────────────────────────────────────────────────
# ASTRO_DEV_BYPASS_PLAN=1   # [DEV UNIQUEMENT] désormais IGNORÉ si NODE_ENV=production
